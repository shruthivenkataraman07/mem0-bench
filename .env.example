# Copy this file to .env and fill in the values you need.
# Nothing in this repository requires a paid API key to run:
# the "local" LLM/embedding providers (see configs/*.yaml) work offline
# and are what the default benchmark and test suite use.

# --- OpenAI (only needed for llm.provider=openai or embeddings.provider=openai) ---
OPENAI_API_KEY=

# --- Mem0 (only needed for the mem0 backend) ---
# If unset, the mem0 backend runs Mem0's OSS `Memory` class locally, which in
# turn needs an LLM configured (OpenAI by default) for fact extraction.
MEM0_API_KEY=

# --- Optional: Mem0 hosted platform base URL override ---
MEM0_BASE_URL=

# --- Benchmark behavior ---
MEM0_BENCH_OUTPUT_DIR=results
MEM0_BENCH_LOG_LEVEL=INFO
